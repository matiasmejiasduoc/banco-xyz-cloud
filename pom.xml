<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.1</version>
		<relativePath/>
	</parent>
	<groupId>cl.duoc</groupId>
	<artifactId>banco-xyz-cloud</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<packaging>pom</packaging>
	<name>banco-xyz-cloud</name>
	<description>Microservicios del Banco XYZ preparados para un entorno cloud seguro y resiliente</description>

	<properties>
		<java.version>21</java.version>
		<resilience4j.version>2.4.0</resilience4j.version>
	</properties>

	<modules>
		<module>commons</module>
		<module>auth-server</module>
		<module>servicios/cuentas-service</module>
		<module>servicios/movimientos-service</module>
		<module>servicios/transacciones-service</module>
		<module>bff/bff-web</module>
		<module>bff/bff-movil</module>
		<module>bff/bff-cajero</module>
	</modules>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>cl.duoc</groupId>
				<artifactId>commons</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>io.github.resilience4j</groupId>
				<artifactId>resilience4j-spring-boot4</artifactId>
				<version>${resilience4j.version}</version>
			</dependency>
		</dependencies>
	</dependencyManagement>
</project>
